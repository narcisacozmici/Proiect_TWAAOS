# ============================================================
# USV Events — Configurare mediu
# Copiați acest fișier în .env și completați valorile reale
# ============================================================

# --- Baza de date PostgreSQL ---
POSTGRES_USER=usvadmin
POSTGRES_PASSWORD=SCHIMBA_CU_PAROLA_SIGURA
POSTGRES_DB=usvevents
DATABASE_URL=postgresql+asyncpg://usvadmin:SCHIMBA_CU_PAROLA_SIGURA@db:5432/usvevents

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Securitate JWT ---
# Generați cu: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SCHIMBA_CU_UN_SIR_RANDOM_DE_MINIM_32_CARACTERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google OAuth 2.0 ---
# Obținut din: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_DE_LA_CONSOLE
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_DE_LA_CONSOLE
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- URLs aplicație ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
